# ============================================================
# XME (Xanther Memory Engine) — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.

# --- PostgreSQL (TimescaleDB) ---
PG_HOST=xme-postgres
PG_PORT=5432
PG_DB=xce_memory
PG_USER=xce_memory
PG_PASSWORD=xme_dev_password

# --- Neo4j ---
NEO4J_URI=bolt://xme-neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=xme_dev_password

# --- LLM (for memory extraction) ---
# OpenRouter API key (or any OpenAI-compatible endpoint)
LLM_API_URL=https://openrouter.ai/api/v1/chat/completions
LLM_API_KEY=your-openrouter-api-key-here
LLM_MODEL=anthropic/claude-sonnet-4-20250514

# --- MCP Server ---
MCP_HOST=0.0.0.0
MCP_PORT=8100

# --- Worker ---
BATCH_SIZE=20
EXTRACTION_INTERVAL=300
MAX_MEMORY_NODES=500

# --- Git Linking (optional) ---
REPO_PATH=/repos/current
REPO_ID=your-repo-id
ARTIFACTS_DIR=memory/sessions
